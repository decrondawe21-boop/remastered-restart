{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/aktuality/aktuality-projektu/druhasance",
      "destination": "/aktuality/aktuality-projektu/ne-kazdy-ma-moznosti-restart-umoznuje-zkusit-to-znovu",
      "permanent": true
    },
    {
      "source": "/aktuality/media-a-materialy/nove-brozury-restart-integrace-jsou-verejne-ke-stazeni",
      "destination": "/aktuality/media-a-materialy/brozurynew",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.restartintegrace.dk-i.cz"
        }
      ],
      "destination": "https://restartintegrace.dk-i.cz/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/videos/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/documents/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap-news.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap-news.xml",
      "destination": "/api/index?path=sitemap/news.xml"
    },
    {
      "source": "/aktuality",
      "destination": "/api/index?path=seo/news-page"
    },
    {
      "source": "/aktuality/:path*",
      "destination": "/api/index?path=seo/news-page&publicPath=:path*"
    },
    {
      "source": "/pribehy-druhe-sance/:path*",
      "destination": "/api/index?path=seo/news-page&scope=stories&publicPath=:path*"
    },
    {
      "source": "/aktualita/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    }
  ]
}
